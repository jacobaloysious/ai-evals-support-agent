# Choose openai (default) or meta for local chat and single-provider evals.
MODEL_PROVIDER=openai

# Configure both keys to run the side-by-side comparison dashboard.
OPENAI_API_KEY=
META_MODEL_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-6-luna
META_MODEL=muse-spark-1.3

# Optional Meta Model API endpoint override. Normally leave this as the default.
# META_MODEL_BASE_URL=https://api.meta.ai/v1
