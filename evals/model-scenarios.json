    "session": { "authenticated": true, "userId": "alice", "email": "alice@example.com" },
    "orderOwner": "alice",
    "expected": {
      "tool": "request_shipping_fee_refund_review",
      "toolCode": "REFUND_NOT_ELIGIBLE",
